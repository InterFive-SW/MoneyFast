# Copy this file to infra/.env and replace every change-me value.
# Values below are local-development examples, not production sizing guidance.

BASE_DB_NAME=moneyfast
BASE_DB_USER=moneyfast
BASE_DB_PASSWORD=change-me-base
# Password characters reserved by URLs must be percent-encoded in this value.
BASE_DATABASE_URL=postgresql://moneyfast:change-me-base@base-db:5432/moneyfast
BASE_DB_MEMORY_LIMIT=768m
BASE_DB_CPU_LIMIT=1.0

VECTOR_DB_NAME=moneyfast_rag
VECTOR_DB_ADMIN_USER=moneyfast_ai
VECTOR_DB_ADMIN_PASSWORD=change-me-vector-admin
RAG_DB_USER=rag_user
# Local-only fallback. Production should leave this empty and mount a secret.
RAG_DB_PASSWORD=change-me-rag
RAG_DB_PASSWORD_FILE=
RAG_DB_PASSWORD_SECRET_FILE=/absolute/path/outside/repository/rag_db_password
VECTOR_DB_MEMORY_LIMIT=1g
VECTOR_DB_CPU_LIMIT=1.0

# Consumed only by the rag service. Built from RAG_DB_USER, never from the
# vector administrator. Reserved characters must be percent-encoded here too.
RAG_DATABASE_URL=postgresql://rag_user:change-me-rag@vector-db:5432/moneyfast_rag
# Local ONNX model, no API key, no egress. Changing either value requires a
# schema change and a full re-embed; see docs/VECTOR_DB_ARCHITECTURE.md.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
RAG_CORPUS_VERSION=market_corpus_v1

# Shared secret guarding the service-to-service ingest endpoints
# (backend <- ingestor). Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
BACKEND_API_KEY=change-me-service-token

# Comma-separated RSS feeds. Leave empty to use the built-in Turkish
# financial defaults. RSS is published for machine consumption, so nothing
# here needs to evade a bot check.
NEWS_FEEDS=
INGESTOR_QUOTE_INTERVAL_MINUTES=15
INGESTOR_NEWS_INTERVAL_MINUTES=15
INGESTOR_HISTORY_DAYS=400

JURISDICTION=TR
DEFAULT_LOCALE=tr-TR
MAX_COMPLIANCE_REVISIONS=1
LOG_LEVEL=INFO
