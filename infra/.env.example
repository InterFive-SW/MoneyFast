# Copy this file to infra/.env and replace every change-me value.
# Values below are local-development examples, not production sizing guidance.

CORE_DB_NAME=moneyfast
CORE_DB_USER=moneyfast
CORE_DB_PASSWORD=change-me-core
# Password characters reserved by URLs must be percent-encoded in this value.
CORE_DATABASE_URL=postgresql://moneyfast:change-me-core@core-db:5432/moneyfast
CORE_DB_MEMORY_LIMIT=768m
CORE_DB_CPU_LIMIT=1.0

VECTOR_DB_NAME=moneyfast_rag
VECTOR_DB_ADMIN_USER=moneyfast_ai
VECTOR_DB_ADMIN_PASSWORD=change-me-vector-admin
RAG_DB_USER=rag_user
# Local-only fallback. Production should leave this empty and mount a secret.
RAG_DB_PASSWORD=change-me-rag
RAG_DB_PASSWORD_FILE=
RAG_DB_PASSWORD_SECRET_FILE=/absolute/path/outside/repository/rag_db_password
VECTOR_DB_MEMORY_LIMIT=1g
VECTOR_DB_CPU_LIMIT=1.0
