BASE_DB_NAME=moneyfast
BASE_DB_USER=moneyfast
BASE_DB_PASSWORD=enter the password here
# Password characters reserved by URLs must be percent-encoded in this value.
BASE_DATABASE_URL=postgresql://moneyfast:enter the password here@base-db:5432/moneyfast
BASE_DB_MEMORY_LIMIT=768m
BASE_DB_CPU_LIMIT=1.0

VECTOR_DB_NAME=moneyfast_rag
VECTOR_DB_ADMIN_USER=moneyfast_ai
VECTOR_DB_ADMIN_PASSWORD=enter the password here
RAG_DB_USER=rag_user
RAG_DB_PASSWORD=enter the password here
RAG_DB_PASSWORD_FILE=
VECTOR_DB_MEMORY_LIMIT=1g
VECTOR_DB_CPU_LIMIT=1.0

RAG_DATABASE_URL=postgresql://rag_user:enter the password here@vector-db:5432/moneyfast_rag
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
RAG_CORPUS_VERSION=market_corpus_v1

JURISDICTION=TR
DEFAULT_LOCALE=tr-TR
MAX_COMPLIANCE_REVISIONS=1
LOG_LEVEL=INFO

# Shared secret for service-to-service ingest endpoints.
BACKEND_API_KEY=enter the key here

# Ingestor scheduling.
INGESTOR_QUOTE_INTERVAL_SECONDS=30
INGESTOR_NEWS_INTERVAL_MINUTES=15
INGESTOR_HISTORY_DAYS=400

# Official X API ingestion. Disabled by default; only the ingestor receives
# these values. Prefer X_BEARER_TOKEN_FILE through the secrets overlay.
X_INGEST_ENABLED=false
X_BEARER_TOKEN_FILE=
X_BEARER_TOKEN=
X_MONITORED_ACCOUNTS_JSON=[]
X_INCLUDE_REPLIES=false
X_INCLUDE_REPOSTS=false
X_POLL_INTERVAL_MINUTES=10
X_MAX_PAGES_PER_ACCOUNT=3
X_BACKEND_BATCH_SIZE=500
X_IDENTITY_REFRESH_HOURS=24

# Phase 2: Market Research Agent social enrichment (agents service).
# Disabled by default. Never place X bearer tokens or DB credentials here for agents.
MARKET_RESEARCH_SOCIAL_SIGNALS_ENABLED=false
MARKET_RESEARCH_SOCIAL_LIMIT=8
MARKET_RESEARCH_SOCIAL_SINCE_HOURS=48
MARKET_RESEARCH_SOCIAL_TIMEOUT_SECONDS=8
MARKET_RESEARCH_SOCIAL_MAX_RETRIES=1
MARKET_RESEARCH_SOCIAL_CONTEXT_CHARS=3500
MARKET_RESEARCH_SOCIAL_MAX_PER_ACCOUNT=2
