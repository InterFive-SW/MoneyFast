CORE_DB_NAME=moneyfast
CORE_DB_USER=moneyfast
CORE_DB_PASSWORD=enter the password here
# Password characters reserved by URLs must be percent-encoded in this value.
CORE_DATABASE_URL=postgresql://moneyfast:enter the password here@base-db:5432/moneyfast
CORE_DB_MEMORY_LIMIT=768m
CORE_DB_CPU_LIMIT=1.0

VECTOR_DB_NAME=moneyfast_rag
VECTOR_DB_ADMIN_USER=moneyfast_ai
VECTOR_DB_ADMIN_PASSWORD=enter the password here
RAG_DB_USER=rag_user
RAG_DB_PASSWORD=enter the password here
RAG_DB_PASSWORD_FILE=
VECTOR_DB_MEMORY_LIMIT=1g
VECTOR_DB_CPU_LIMIT=1.0

RAG_DATABASE_URL=postgresql://rag_user:enter the password here@vector-db:5432/moneyfast_rag
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
RAG_CORPUS_VERSION=market_corpus_v1

JURISDICTION=TR
DEFAULT_LOCALE=tr-TR
MAX_COMPLIANCE_REVISIONS=1
LOG_LEVEL=INFO

# Shared secret for service-to-service ingest endpoints.
BACKEND_API_KEY=enter the key here

# ── Ingestor ─────────────────────────────────────────────────────────────────
# Hisse fiyatlarının toplu tur aralığı, dakika. Beş dakika: bir işlem gününe
# tam 78 tane 5 dakikalık bar sığıyor ve gün içi grafik o kadar nokta istiyor.
# Turlar bütçesini aşarsa (ingestor bunu uyarı olarak yazar) 10'a çekin.
INGESTOR_QUOTE_INTERVAL_MINUTES=5
# Kur/altın/endeks şeridi ayrı ve hızlı: birkaç sembol, 30 saniye.
INGESTOR_BAND_INTERVAL_SECONDS=30
# Günlük bar geçmişi. 730 = iki yıl; performans grafiği o kadar geriye gidiyor.
INGESTOR_HISTORY_DAYS=730
# Açılışta çekilen gün içi geçmiş, gün. Aylık grafik 5 dakikalık barların
# saatlik kovalarından çiziliyor; sağlayıcı bu barları ~60 gün geriye veriyor.
INGESTOR_INTRADAY_HISTORY_DAYS=30
