# Copy to .env and fill in. Never commit .env.

# --- LLM -------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Cheap/fast alternative for routing and extraction only:
GROQ_FAST_MODEL=llama-3.1-8b-instant

# --- MCP -------------------------------------------------------------------
# Inside docker compose this is the CONTAINER NAME, not localhost.
MCP_SERVER_URL=http://mcp-market-data:8000/sse
MCP_TIMEOUT_SECONDS=30
MCP_MAX_RETRIES=1

# --- Behaviour -------------------------------------------------------------
JURISDICTION=TR
DEFAULT_LOCALE=tr-TR
MAX_COMPLIANCE_REVISIONS=1
LOG_LEVEL=INFO
