# Copy to .env and fill in. Never commit .env.

# --- LLM -------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Cheap/fast alternative for routing and extraction only:
GROQ_FAST_MODEL=llama-3.1-8b-instant

# --- MCP -------------------------------------------------------------------
# Inside docker compose this is the CONTAINER NAME, not localhost.
MCP_SERVER_URL=http://mcp:8000/sse
MCP_TIMEOUT_SECONDS=30
MCP_MAX_RETRIES=1

# --- Behaviour -------------------------------------------------------------
JURISDICTION=TR
DEFAULT_LOCALE=tr-TR
MAX_COMPLIANCE_REVISIONS=1
LOG_LEVEL=INFO

# Phase 2: Market Research Agent may attach Phase 1 social signals.
# Disabled by default. Agents never receive X bearer tokens or DB credentials.
MARKET_RESEARCH_SOCIAL_SIGNALS_ENABLED=false
MARKET_RESEARCH_SOCIAL_LIMIT=8
MARKET_RESEARCH_SOCIAL_SINCE_HOURS=48
MARKET_RESEARCH_SOCIAL_TIMEOUT_SECONDS=8
MARKET_RESEARCH_SOCIAL_MAX_RETRIES=1
MARKET_RESEARCH_SOCIAL_CONTEXT_CHARS=3500
MARKET_RESEARCH_SOCIAL_MAX_PER_ACCOUNT=2
