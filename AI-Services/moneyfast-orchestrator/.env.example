# Copy to .env and fill in. Never commit .env.

# --- LLM -------------------------------------------------------------------
# Sağlayıcı: groq | nvidia | openai. Üçü de OpenAI-uyumlu
# `/chat/completions` konuşuyor, dolayısıyla tek istemci hepsini kapsıyor.
# Tanınmayan bir ad HATA verir; sessizce bir varsayılana düşmez, çünkü
# yanlış sağlayıcıya doğru model adını göndermek anlaşılmaz bir 404 demek.
LLM_PROVIDER=groq

# Ortak anahtar. Hangi sağlayıcı seçiliyse onun için kullanılır ve
# sağlayıcıya özel addan (GROQ_API_KEY, NVIDIA_API_KEY...) ÖNCE okunur.
LLM_API_KEY=

# Sağlayıcıya özel adlar da çalışıyor. Model adları ortak DEĞİL:
# `llama-3.3-70b-versatile` ile `meta/llama-3.3-70b-instruct` birbirinin
# yerine geçmez, o yüzden her sağlayıcının kendi değişkeni var.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FAST_MODEL=llama-3.1-8b-instant 
#
# NVIDIA NIM anahtarları `nvapi-` ile başlar. 
# NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_FAST_MODEL=meta/llama-3.1-8b-instruct

# Kota hatasında yeniden deneme. 1,5 saniye Groq'un dakikalık penceresine
# karşı ölçüldü; başka bir sağlayıcı için yeniden ölçülmedi.
# LLM_MAX_ATTEMPTS=3
# LLM_BACKOFF_SECONDS=1.5

# --- MCP -------------------------------------------------------------------
# Inside docker compose this is the CONTAINER NAME, not localhost.
MCP_SERVER_URL=http://mcp:8000/sse
MCP_TIMEOUT_SECONDS=30
MCP_MAX_RETRIES=1

# --- Behaviour -------------------------------------------------------------
JURISDICTION=TR
DEFAULT_LOCALE=tr-TR
MAX_COMPLIANCE_REVISIONS=1
LOG_LEVEL=INFO
